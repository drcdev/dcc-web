# Cloudflare account ID the setup check reads. Not secret.
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare zone ID for doncoleman.ca the setup check reads. Not secret.
CLOUDFLARE_ZONE_ID=
# Read-only Cloudflare API token (Zone Read, DNS Read, Workers Scripts Read,
# Account Settings Read, D1 Read, Workers Builds Configuration Read, Turnstile Sites Read)
# used only by the setup check. Secret — never commit a value.
CLOUDFLARE_API_TOKEN=
