{
  "name": "dcc-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint:secrets": "secretlint \"**/*\"",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --project=a11y",
    "test:budget": "playwright test --project=budget",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "reference:capture": "playwright test --config tests/reference/playwright.config.ts",
    "deploy:preview": "node scripts/deploy/preview.ts",
    "verify": "pnpm run lint:secrets && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:e2e",
    "setup:check": "node scripts/setup-check/cli.ts",
    "setup:dns-snapshot": "node scripts/setup-check/dns-snapshot.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.6",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.19.0",
    "cloudflare": "7.2.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "secretlint": "13.0.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2",
    "wrangler": "4.143.0"
  }
}
