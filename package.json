{
  "name": "dcc-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "build:fixtures": "node scripts/build-fixture-site.ts",
    "fonts:diagrams": "node scripts/fonts/embed-diagram-fonts.ts",
    "lint:secrets": "secretlint \"**/*\"",
    "lint": "eslint .",
    "typecheck": "astro check && tsc -p worker && wrangler types worker/worker-configuration.d.ts --check",
    "test": "vitest run && pnpm run test:worker",
    "test:unit": "vitest run --project unit",
    "test:build": "vitest run --project build",
    "test:build:content": "vitest run --project build tests/build/indexing.test.ts tests/build/local-site.test.ts tests/build/project-template.test.ts",
    "test:worker": "pnpm --filter ./worker test",
    "test:e2e": "playwright test",
    "test:e2e:parallel": "playwright test --project=e2e --project=a11y --project=visual --project=sections",
    "test:a11y": "playwright test --project=a11y",
    "test:budget": "playwright test --project=budget --workers=1",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:visual:update:linux": "bash scripts/visual-baselines-linux.sh",
    "reference:capture": "playwright test --config tests/reference/playwright.config.ts",
    "deploy:preview": "node scripts/deploy/preview.ts",
    "deploy:production": "node scripts/deploy/production.ts",
    "types:worker": "wrangler types worker/worker-configuration.d.ts",
    "verify": "pnpm run lint:secrets && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:e2e",
    "verify:quick": "pnpm run lint:secrets && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run test:worker && pnpm run build",
    "setup:check": "node scripts/setup-check/cli.ts",
    "site:check": "node scripts/site-check/cli.ts",
    "setup:dns-snapshot": "node scripts/setup-check/dns-snapshot.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "satteri": "0.10.5",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.6",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.19.0",
    "cloudflare": "7.2.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "secretlint": "13.0.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2",
    "wrangler": "4.144.0"
  }
}
