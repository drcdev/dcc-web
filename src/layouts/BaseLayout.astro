---
// The document shell every page renders inside (port of Flux default.hbs;
// contracts/shell-dom.md; research R4, R5). The server-rendered <html> is dark,
// so a visitor without JavaScript always gets the default theme; the inline
// pre-paint script then applies any stored choice and adds `js` before the
// stylesheet loads, so the wrong theme never flashes (FR-013). It is rendered
// with is:inline because Astro's processed scripts are deferred modules that
// run after first paint (docs.astro.build/en/guides/client-side-scripts/#script-processing).
import "../styles/global.css";
import themeInit from "../scripts/theme-init.js?raw";
import Seo, { type Props as SeoProps } from "../components/Seo.astro";
import SkipLink from "../components/SkipLink.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import type { NavigationItem } from "../config/navigation";

export type Props = SeoProps & {
  /** Header items, from getNavigation() (src/lib/pages.ts). */
  navigation: NavigationItem[];
};

const { navigation, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark motion-safe:scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={themeInit} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...seo} />
    <slot name="head" />
  </head>
  <body class="bg-white dark:bg-dusk-BASE antialiased">
    <SkipLink />
    <SiteHeader navigation={navigation} />
    <div class="page-container">
      <main id="main" tabindex="-1" class="container mx-auto p-4 mt-4">
        <slot />
      </main>
    </div>
    <SiteFooter />
  </body>
</html>
