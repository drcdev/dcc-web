---
// Standard page: title, optional feature image, draft notice and the page body,
// inside BaseLayout (port of Flux page.hbs + content-section.hbs;
// contracts/page-dom.md). No share bar: that belongs to the Blog feature.
import type { ImageMetadata } from "astro";
import BaseLayout from "./BaseLayout.astro";
import DraftNotice from "../components/page/DraftNotice.astro";
import FeatureImage from "../components/page/FeatureImage.astro";
import type { NavigationItem } from "../config/navigation";

export interface Props {
  title: string;
  description: string;
  navigation: NavigationItem[];
  /** Sharing image path and its alt text; the site default when omitted. */
  image?: string;
  imageAlt?: string;
  featureImage?: { src: ImageMetadata; alt: string; caption?: string };
  draft?: boolean;
  /** The home page's document title is the site name alone. */
  home?: boolean;
}

const { title, description, navigation, image, imageAlt, featureImage, draft = false, home = false } = Astro.props;
---

<BaseLayout title={home ? undefined : title} description={description} image={image} imageAlt={imageAlt} navigation={navigation}>
  <article class="mx-auto">
    <section class="mx-auto mb-8 max-w-screen-lg">
      <h1 class="my-4 text-5xl font-bold break-words text-dusk-900 dark:text-white">{title}</h1>
    </section>
    {
      featureImage && (
        <section class="mx-auto mb-8 max-w-screen-lg">
          <FeatureImage src={featureImage.src} alt={featureImage.alt} caption={featureImage.caption} />
        </section>
      )
    }
    <section
      id="content-section"
      class="prose lg:prose-lg dark:prose-invert prose-accent mx-auto mb-8 max-w-screen-lg dark:rounded-2xl dark:bg-dusk-800 dark:p-6"
    >
      {draft && <DraftNotice />}
      <slot />
    </section>
  </article>
</BaseLayout>
