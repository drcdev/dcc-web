---
// One stage on the timeline rail (FR-010, FR-012, FR-013): a numbered marker in
// the gutter, then the heading, draft mark and text, with the stage's visual
// beside the text at desktop width and after it on a phone. Slot content sits
// below both, full width. With no visual there is no second column.
import type { StageId, StoryStage } from "../types.ts";
import DraftMark from "../shared/DraftMark.astro";
import VisualView from "../shared/VisualView.astro";
import "../shared/stage-accents.css";
import "./a.css";

interface Props {
  stage: StoryStage;
  /** Position on the rail, from 1. */
  number: number;
}
const { stage, number } = Astro.props;
const headingId = `${stage.id}-heading`;
const stageClass: `stage-${StageId}` = `stage-${stage.id}`;
---

<section id={stage.id} aria-labelledby={headingId} data-stage={stage.id} class:list={["tl-stage", stageClass]}>
  <span class="tl-marker" data-marker aria-hidden="true">{number}</span>
  <div class="tl-body" data-reveal>
    <div class:list={["tl-split", stage.visual && "tl-split--visual"]}>
      <div class="tl-text">
        <h2 id={headingId} class="tl-heading">{stage.heading}</h2>
        <p class="mb-3"><DraftMark /></p>
        {stage.body.map((p) => <p class="mb-3">{p}</p>)}
      </div>
      {
        stage.visual && (
          <div data-stage-visual>
            <VisualView visual={stage.visual} idPrefix={`${stage.id}-visual`} />
          </div>
        )
      }
    </div>
    <div class="tl-after"><slot /></div>
  </div>
</section>
