---
// Direction A "Timeline" index: one vertical list on the same rail as the story,
// an entry per project (FR-020, FR-021, FR-024, FR-025). Only Focus Pocus links
// to a story; every other entry links only to its drc.dev page.
import type { ProjectEntry } from "../types.ts";
import PortfolioFilter from "../shared/PortfolioFilter.astro";
import PrototypeNotice from "../shared/PrototypeNotice.astro";
import StatusBadge from "../shared/StatusBadge.astro";
import ThemePills from "../shared/ThemePills.astro";
import VisualView from "../shared/VisualView.astro";
import "./a.css";

interface Props {
  entries: ProjectEntry[];
}
const { entries } = Astro.props;
const storyBase = "/design/portfolio/a";
---

<PrototypeNotice />
<header class="mb-6 max-w-3xl">
  <h1 class="mb-2 text-4xl font-bold text-dusk-900 dark:text-mist-100">Projects</h1>
  <p class="text-dusk-800 dark:text-mist-200">{entries[0]?.reviewNote}</p>
</header>

<PortfolioFilter entries={entries}>
  <ul class="timeline m-0 list-none p-0">
    {
      entries.map((entry) => (
        <li class="tl-entry" data-entry={entry.slug} data-themes={entry.themes.join("|")}>
          <span class="tl-marker tl-marker--dot" aria-hidden="true" />
          <div class="tl-body" data-reveal>
            <div class="tl-split tl-split--visual">
              <div class="tl-text">
                <h2 class="tl-entry-title">
                  {entry.storyPath ? (
                    <a class="tl-link text-2xl" href={`${storyBase}${entry.storyPath}`}>
                      {entry.title}
                    </a>
                  ) : (
                    entry.title
                  )}
                </h2>
                <p class="mt-2">{entry.problem}</p>
                <div class="tl-entry-meta">
                  <StatusBadge status={entry.status} />
                  <ThemePills themes={entry.themes} />
                </div>
                <p class="mt-3">
                  <a class="tl-link" href={entry.externalHref}>
                    {entry.title} on drc.dev
                  </a>
                </p>
              </div>
              <div data-entry-visual>
                <VisualView visual={entry.visual} idPrefix={`${entry.slug}-visual`} />
              </div>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</PortfolioFilter>
