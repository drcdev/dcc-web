---
// Direction A "Timeline" story: the notice, the title and problem line, then
// seven stages down a rail, ending with the invitation (contracts/prototype-routes.md).
import type { SampleStory } from "../types.ts";
import { STAGE_ORDER } from "../types.ts";
import { contactHref } from "../contact-link.ts";
import DraftNotice from "../../../components/page/DraftNotice.astro";
import PrototypeNotice from "../shared/PrototypeNotice.astro";
import TimelineStage from "./TimelineStage.astro";
import OptionDetails from "./OptionDetails.astro";
import "./a.css";

interface Props {
  story: SampleStory;
}
const { story } = Astro.props;
const stages = STAGE_ORDER.map((id) => story.stages.find((s) => s.id === id)!);
---

<PrototypeNotice />
<DraftNotice />
<header class="mb-8 max-w-3xl">
  <h1 class="mb-2 text-4xl font-bold text-dusk-900 dark:text-mist-100">{story.entry.title}</h1>
  <p class="text-lg text-dusk-800 dark:text-mist-200">{story.entry.problem}</p>
</header>

<div class="timeline">
  {
    stages.map((stage, i) => (
      <TimelineStage stage={stage} number={i + 1}>
        {stage.id === "options" && (
          <ul class="tl-options">
            {story.options.map((option) => (
              <li>
                <OptionDetails option={option} />
              </li>
            ))}
          </ul>
        )}
        {stage.id === "built" && (
          <>
            <p class="text-dusk-800 dark:text-mist-200">{story.demo.standInNote}</p>
            <ul class="tl-links">
              <li>
                <a class="tl-link" href={story.demo.href}>Focus Pocus on drc.dev</a>
              </li>
              <li>
                <a class="tl-link" href={story.demo.secondaryHref}>Source code on GitHub</a>
              </li>
            </ul>
          </>
        )}
        {stage.id === "invitation" && (
          <a class="tl-cta" href={contactHref(story.entry.slug)}>Tell me about it</a>
        )}
      </TimelineStage>
    ))
  }
</div>
