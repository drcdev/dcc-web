---
// Direction B "Cards" story: the notice, the title and problem line, then seven
// stage cards, ending with the invitation (contracts/prototype-routes.md).
import type { SampleStory } from "../types.ts";
import { STAGE_ORDER } from "../types.ts";
import { contactHref } from "../contact-link.ts";
import DraftNotice from "../../../components/page/DraftNotice.astro";
import PrototypeNotice from "../shared/PrototypeNotice.astro";
import StageCard from "./StageCard.astro";
import OptionTabs from "./OptionTabs.astro";
import DemoPanel from "./DemoPanel.astro";
import "./b.css";

interface Props {
  story: SampleStory;
}
const { story } = Astro.props;
const stages = STAGE_ORDER.map((id) => story.stages.find((s) => s.id === id)!);
---

<PrototypeNotice />
<DraftNotice />
<header class="mb-8 max-w-3xl">
  <h1 data-vt-title class="mb-2 text-5xl font-extrabold text-dusk-900 dark:text-mist-100">{story.entry.title}</h1>
  <p class="text-lg text-dusk-800 dark:text-mist-200">{story.entry.problem}</p>
</header>

<div class="bc-story">
  {
    stages.map((stage) => (
      <StageCard stage={stage}>
        {stage.id === "options" && <OptionTabs options={story.options} />}
        {stage.id === "built" && <DemoPanel demo={story.demo} />}
        {stage.id === "invitation" && (
          <a class="bc-cta" href={contactHref(story.entry.slug)}>Tell me about it</a>
        )}
      </StageCard>
    ))
  }
</div>
