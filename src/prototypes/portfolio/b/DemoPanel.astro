---
// The demo in Direction B (FR-014): a placeholder frame for the still or clip,
// the stand-in note, and links to the demo page and the repository. No iframe,
// no autoplay.
import type { Demo } from "../types.ts";
import VisualView from "../shared/VisualView.astro";
import "./b.css";

interface Props {
  demo: Demo;
}
const { demo } = Astro.props;
---

<div data-demo-panel>
  <VisualView visual={demo.still} idPrefix="demo-still" />
  <p class="mt-3 text-dusk-800 dark:text-mist-200">{demo.standInNote}</p>
  <ul class="bc-links">
    <li><a class="bc-link" href={demo.href}>Focus Pocus on drc.dev</a></li>
    <li><a class="bc-link" href={demo.secondaryHref}>Source code on GitHub</a></li>
  </ul>
</div>
