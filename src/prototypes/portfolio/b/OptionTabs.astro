---
// <option-tabs> island (contracts/islands.md; FR-011, FR-016, FR-017). Every
// option is a card in the HTML and the chosen one is labelled "Chosen" with its
// reason, so without JavaScript all options are stacked and no tab button is
// visible. With script the buttons become a WAI-ARIA tab list with automatic
// activation and the other panels are hidden.
import type { StoryOption } from "../types.ts";
import "./b.css";

interface Props {
  options: StoryOption[];
}
const { options } = Astro.props;
---

<option-tabs>
  <div data-tablist data-label="Options considered" class="bc-tablist hidden js:flex">
    {
      options.map((option) => (
        <button type="button" data-tab={option.id} class="bc-tab min-h-11 min-w-8">
          {option.name}
          {option.chosen && <span class="bc-chosen">Chosen</span>}
        </button>
      ))
    }
  </div>
  <div data-panels>
    {
      options.map((option) => (
        <article data-option={option.id} data-chosen={option.chosen ? "" : undefined} class="bc-option">
          <h3 class="bc-option-name">
            {option.name}
            {option.chosen && <span class="bc-chosen">Chosen</span>}
          </h3>
          <p>{option.summary}</p>
          <p>
            <strong>In its favour</strong>
          </p>
          <ul>{option.pros.map((line) => <li>{line}</li>)}</ul>
          <p>
            <strong>Against it</strong>
          </p>
          <ul>{option.cons.map((line) => <li>{line}</li>)}</ul>
          {
            option.chosen && option.reason && (
              <p>
                <strong>Why it was chosen.</strong> {option.reason}
              </p>
            )
          }
        </article>
      ))
    }
  </div>
</option-tabs>

<script>
  class OptionTabs extends HTMLElement {
    connectedCallback() {
      const list = this.querySelector<HTMLElement>("[data-tablist]");
      const tabs = [...this.querySelectorAll<HTMLButtonElement>("[data-tab]")];
      const panels = [...this.querySelectorAll<HTMLElement>("[data-option]")];
      if (!list || tabs.length === 0 || tabs.length !== panels.length) return;

      list.setAttribute("role", "tablist");
      list.setAttribute("aria-label", list.dataset.label ?? "Options");
      tabs.forEach((tab, i) => {
        const panel = panels[i]!;
        tab.setAttribute("role", "tab");
        tab.id = `option-tab-${tab.dataset.tab}`;
        panel.id = `option-panel-${tab.dataset.tab}`;
        tab.setAttribute("aria-controls", panel.id);
        panel.setAttribute("role", "tabpanel");
        panel.setAttribute("aria-labelledby", tab.id);
        panel.tabIndex = 0;
      });

      const select = (index: number, focus: boolean) => {
        tabs.forEach((tab, i) => {
          const on = i === index;
          tab.setAttribute("aria-selected", String(on));
          tab.tabIndex = on ? 0 : -1;
          panels[i]!.hidden = !on;
        });
        if (focus) tabs[index]!.focus();
      };

      tabs.forEach((tab, i) => tab.addEventListener("click", () => select(i, false)));
      list.addEventListener("keydown", (event) => {
        const current = tabs.indexOf(document.activeElement as HTMLButtonElement);
        if (current < 0) return;
        const last = tabs.length - 1;
        const next =
          event.key === "ArrowRight" ? (current === last ? 0 : current + 1)
          : event.key === "ArrowLeft" ? (current === 0 ? last : current - 1)
          : event.key === "Home" ? 0
          : event.key === "End" ? last
          : -1;
        if (next < 0) return;
        event.preventDefault();
        select(next, true);
      });

      select(Math.max(0, panels.findIndex((p) => p.hasAttribute("data-chosen"))), false);
    }
  }
  if (!customElements.get("option-tabs")) customElements.define("option-tabs", OptionTabs);
</script>
