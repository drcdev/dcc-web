---
// Theme tags for an entry, as a list of text labels (FR-025).
import type { Theme } from "../types.ts";

interface Props {
  themes: Theme[];
}
const { themes } = Astro.props;
---

<ul class="not-prose m-0 flex list-none flex-wrap gap-1 p-0" aria-label="Themes">
  {
    themes.map((theme) => (
      <li class="rounded border border-mauve-700 px-2 py-0.5 text-xs text-dusk-900 dark:border-mauve-300 dark:text-mist-100">
        {theme}
      </li>
    ))
  }
</ul>
