---
// Architecture diagram for the "What was built" stage (FR-033, FR-038): four
// boxes in a row joined by arrows, drawn with currentColor so the site's text
// colour, dark mode and forced colours all apply. Classes only, no inline style.
interface Props {
  label: string;
  description: string;
  idPrefix?: string;
}
const { label, description, idPrefix = "architecture" } = Astro.props;
const labelId = `${idPrefix}-label`;
const descId = `${idPrefix}-desc`;
const boxes = [
  { x: 4, text: "Claude Desktop" },
  { x: 132, text: "Focus Pocus" },
  { x: 260, text: "JXA scripts" },
  { x: 388, text: "OmniFocus" },
];
---

<figure data-diagram="architecture" class="not-prose m-0 text-dusk-800 dark:text-mist-200">
  <svg
    role="img"
    aria-labelledby={`${labelId} ${descId}`}
    viewBox="0 0 490 130"
    class="h-auto w-full"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
  >
    <title id={labelId}>{label}</title>
    <desc id={descId}>{description}</desc>
    {
      boxes.map((b) => (
        <>
          <rect x={b.x} y="30" width="98" height="52" rx="6" />
          <text x={b.x + 49} y="62" text-anchor="middle" font-size="13" fill="currentColor" stroke="none">
            {b.text}
          </text>
        </>
      ))
    }
    <path d="M104 56h24m-6-6 6 6-6 6M232 56h24m-6-6 6 6-6 6M360 56h24m-6-6 6 6-6 6" />
    <text x="181" y="108" text-anchor="middle" font-size="11" fill="currentColor" stroke="none">
      MCP server, 35+ tools
    </text>
    <text x="309" y="108" text-anchor="middle" font-size="11" fill="currentColor" stroke="none">
      39 scripts
    </text>
  </svg>
  <figcaption class="mt-2 text-sm">{description}</figcaption>
</figure>
