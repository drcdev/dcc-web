---
// <portfolio-filter> island (contracts/islands.md; FR-022, FR-035, FR-036).
// The whole entry list is in the HTML; without JavaScript every entry shows and
// the controls stay hidden. The default slot holds the entry list, each entry
// marked `data-entry` with `data-themes="Theme one|Theme two"`.
import type { ProjectEntry } from "../types.ts";
import { themesOf } from "../filter.ts";

interface Props {
  entries: ProjectEntry[];
}
const { entries } = Astro.props;
const themes = themesOf(entries);
const button =
  "min-h-8 min-w-8 rounded border border-dusk-700 px-3 py-1 text-sm text-dusk-900 aria-pressed:bg-dusk-900 aria-pressed:text-white dark:border-mist-300 dark:text-mist-100 dark:aria-pressed:bg-mist-100 dark:aria-pressed:text-dusk-900";
---

<portfolio-filter data-total={entries.length}>
  <div class="not-prose mb-4">
    <p id="filter-label" class="mb-2 text-sm font-semibold text-dusk-900 dark:text-mist-100">Filter by theme</p>
    <div role="group" aria-labelledby="filter-label" class="hidden js:flex flex-wrap gap-2">
      <button type="button" aria-pressed="true" data-filter-all class={button}>All projects</button>
      {
        themes.map((theme) => (
          <button type="button" aria-pressed="false" data-theme={theme} class={button}>
            {theme}
          </button>
        ))
      }
    </div>
    <p
      role="status"
      aria-live="polite"
      data-filter-status
      class="hidden js:block mt-2 text-sm text-dusk-800 dark:text-mist-200"
    >
      Showing all {entries.length} projects.
    </p>
  </div>
  <slot />
  <div data-filter-empty hidden class="not-prose mt-4 text-dusk-900 dark:text-mist-100">
    <p>No projects match this theme.</p>
    <button type="button" data-filter-clear class={button}>Show all projects</button>
  </div>
</portfolio-filter>

<script>
  import { matches, parseThemeParam } from "../filter.ts";

  class PortfolioFilter extends HTMLElement {
    connectedCallback() {
      const entries = [...this.querySelectorAll<HTMLElement>("[data-entry]")];
      const buttons = [...this.querySelectorAll<HTMLButtonElement>("button[aria-pressed]")];
      const status = this.querySelector<HTMLElement>("[data-filter-status]");
      const empty = this.querySelector<HTMLElement>("[data-filter-empty]");
      const known = buttons.map((b) => b.dataset.theme).filter((t): t is string => Boolean(t));
      const total = entries.length;

      const apply = (theme: string | null, unknown = false, writeUrl = true) => {
        let shown = 0;
        for (const entry of entries) {
          const themes = (entry.dataset.themes ?? "").split("|");
          const show = !unknown && matches({ themes }, theme);
          entry.hidden = !show;
          if (show) shown += 1;
        }
        for (const b of buttons) {
          b.setAttribute("aria-pressed", String(b.dataset.theme ? b.dataset.theme === theme : !theme && !unknown));
        }
        if (empty) empty.hidden = shown !== 0;
        if (status) {
          status.textContent = unknown || shown === 0
            ? "No projects match this theme."
            : theme === null
              ? `Showing all ${total} projects.`
              : `Showing ${shown} ${shown === 1 ? "project" : "projects"} about ${theme}.`;
        }
        if (!writeUrl) return;
        const url = new URL(location.href);
        if (theme) url.searchParams.set("theme", theme);
        else url.searchParams.delete("theme");
        history.replaceState(null, "", url);
      };

      for (const b of buttons) b.addEventListener("click", () => apply(b.dataset.theme ?? null));
      this.querySelector("[data-filter-clear]")?.addEventListener("click", () => apply(null));

      const initial = parseThemeParam(location.search, known);
      // An unknown value is left in the address until the reader clears the filter.
      if (initial.theme || initial.unknown) apply(initial.theme, initial.unknown, false);
    }
  }
  if (!customElements.get("portfolio-filter")) customElements.define("portfolio-filter", PortfolioFilter);
</script>
