---
// The visual panel of a chapter (FR-012). It follows the chapter's text in the
// reading order; on wide screens with motion allowed the CSS keeps it in view
// beside the text. Holds no controls, so it can never take focus.
import type { Visual } from "../types.ts";
import VisualView from "../shared/VisualView.astro";
import "./c.css";

interface Props {
  visual: Visual;
  idPrefix?: string;
}
const { visual, idPrefix } = Astro.props;
---

<div data-sticky-visual data-stage-visual class="cc-visual">
  <VisualView visual={visual} idPrefix={idPrefix} />
</div>
