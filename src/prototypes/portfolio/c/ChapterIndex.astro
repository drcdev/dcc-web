---
// Direction C "Chapters" index: a contents page. One ruled row per project
// (FR-020, FR-021, FR-024, FR-025): title and meta, then the problem and its
// links, then the visual. Only Focus Pocus links to a story; every other entry
// links only to its drc.dev page.
import type { ProjectEntry } from "../types.ts";
import PortfolioFilter from "../shared/PortfolioFilter.astro";
import PrototypeNotice from "../shared/PrototypeNotice.astro";
import StatusBadge from "../shared/StatusBadge.astro";
import ThemePills from "../shared/ThemePills.astro";
import VisualView from "../shared/VisualView.astro";
import "./c.css";

interface Props {
  entries: ProjectEntry[];
}
const { entries } = Astro.props;
const storyBase = "/design/portfolio/c";
---

<PrototypeNotice />
<header class="mb-8 max-w-3xl">
  <h1 class="mb-2 text-5xl font-extrabold tracking-tight text-dusk-900 md:text-7xl dark:text-mist-100">Projects</h1>
  <p class="text-lg text-dusk-800 dark:text-mist-200">{entries[0]?.reviewNote}</p>
</header>

<PortfolioFilter entries={entries}>
  <ul class="cc-list">
    {
      entries.map((entry) => (
        <li class="cc-entry" data-entry={entry.slug} data-themes={entry.themes.join("|")}>
          <div>
            <h2 class="cc-title" data-vt-title={entry.storyPath ? "" : undefined}>
              {entry.title}
            </h2>
            <div class="cc-meta">
              <StatusBadge status={entry.status} />
              <ThemePills themes={entry.themes} />
            </div>
          </div>
          <div>
            <p class="cc-problem">{entry.problem}</p>
            <ul class="cc-links">
              {entry.storyPath && (
                <li>
                  <a class="cc-link" href={`${storyBase}${entry.storyPath}`}>
                    {entry.title}
                  </a>
                </li>
              )}
              <li>
                <a class="cc-link" href={entry.externalHref}>
                  {entry.title} on drc.dev
                </a>
              </li>
            </ul>
          </div>
          <div data-entry-visual>
            <VisualView visual={entry.visual} idPrefix={`${entry.slug}-visual`} />
          </div>
        </li>
      ))
    }
  </ul>
</PortfolioFilter>
