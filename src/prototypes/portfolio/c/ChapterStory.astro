---
// Direction C "Chapters" story: the notice, the title and problem line, a
// chapter list, then seven chapters, ending with the invitation
// (contracts/prototype-routes.md).
import type { SampleStory } from "../types.ts";
import { STAGE_ORDER } from "../types.ts";
import { contactHref } from "../contact-link.ts";
import DraftNotice from "../../../components/page/DraftNotice.astro";
import PrototypeNotice from "../shared/PrototypeNotice.astro";
import Chapter from "./Chapter.astro";
import OptionTable from "./OptionTable.astro";
import "./c.css";

interface Props {
  story: SampleStory;
}
const { story } = Astro.props;
const stages = STAGE_ORDER.map((id) => story.stages.find((s) => s.id === id)!);
---

<PrototypeNotice />
<DraftNotice />
<div data-progress aria-hidden="true" class="cc-progress"></div>
<div class="cc-story">
  <header class="mb-8 max-w-3xl">
    <h1 data-vt-title class="mb-2 text-5xl font-extrabold tracking-tight text-dusk-900 md:text-7xl dark:text-mist-100">
      {story.entry.title}
    </h1>
    <p class="text-xl text-dusk-800 dark:text-mist-200">{story.entry.problem}</p>
  </header>

  <nav aria-label="Chapters" class="cc-rail">
    <p class="cc-rail-title">In this story</p>
    <ol>
      {stages.map((stage) => <li><a href={`#${stage.id}`}>{stage.heading}</a></li>)}
    </ol>
  </nav>

  {
    stages.map((stage, i) => (
      <Chapter stage={stage} number={i + 1} total={stages.length}>
        {stage.id === "options" && <OptionTable options={story.options} constraints={story.constraints} />}
        {stage.id === "built" && (
          <div class="cc-demo" data-demo-panel>
            <p>{story.demo.standInNote}</p>
            <ul class="cc-links">
              <li>
                <a class="cc-link" href={story.demo.href}>Focus Pocus on drc.dev</a>
              </li>
              <li>
                <a class="cc-link" href={story.demo.secondaryHref}>Source code on GitHub</a>
              </li>
            </ul>
          </div>
        )}
        {stage.id === "invitation" && <a class="cc-cta" href={contactHref(story.entry.slug)}>Tell me about it</a>}
      </Chapter>
    ))
  }
</div>
