---
// The options as one comparison table (FR-011): options across, constraints
// down, in a keyboard-reachable scrolling region. Static HTML, so it needs no
// JavaScript. Fit is written in words; the chosen option's column is labelled
// "Chosen" in its header, and its reason follows the table.
import type { Constraint, Fit, StoryOption } from "../types.ts";
import "./c.css";

interface Props {
  options: StoryOption[];
  constraints: Constraint[];
}
const { options, constraints } = Astro.props;
const fitText: Record<Fit, { mark: string; text: string }> = {
  meets: { mark: "✓", text: "Meets" },
  partly: { mark: "~", text: "Partly meets" },
  misses: { mark: "✗", text: "Does not meet" },
};
const chosen = options.find((o) => o.chosen);
---

<div role="region" aria-labelledby="options-table-caption" tabindex="0" class="cc-region">
  <table class="cc-table">
    <caption id="options-table-caption">Options considered, compared on what each one offers and on the four constraints</caption>
    <thead>
      <tr>
        <th scope="col">What to compare</th>
        {
          options.map((o) => (
            <th scope="col" data-chosen={o.chosen ? "" : undefined}>
              {o.name}
              {o.chosen && <span class="cc-chosen">Chosen</span>}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">Summary</th>
        {options.map((o) => <td data-chosen={o.chosen ? "" : undefined}>{o.summary}</td>)}
      </tr>
      <tr>
        <th scope="row">In its favour</th>
        {
          options.map((o) => (
            <td data-chosen={o.chosen ? "" : undefined}>
              <ul>{o.pros.map((line) => <li>{line}</li>)}</ul>
            </td>
          ))
        }
      </tr>
      <tr>
        <th scope="row">Against it</th>
        {
          options.map((o) => (
            <td data-chosen={o.chosen ? "" : undefined}>
              <ul>{o.cons.map((line) => <li>{line}</li>)}</ul>
            </td>
          ))
        }
      </tr>
      {
        constraints.map((c) => (
          <tr>
            <th scope="row">
              {c.label}
              <small>{c.detail}</small>
            </th>
            {options.map((o) => (
              <td data-chosen={o.chosen ? "" : undefined}>
                <span class="cc-fit">
                  <span aria-hidden="true">{fitText[o.fit[c.id]].mark} </span>
                  {fitText[o.fit[c.id]].text}
                </span>
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
{
  chosen?.reason && (
    <p class="cc-reason">
      <strong>Why {chosen.name} was chosen.</strong> {chosen.reason}
    </p>
  )
}
