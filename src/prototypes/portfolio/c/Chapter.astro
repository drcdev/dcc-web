---
// One story stage as a chapter (FR-010, FR-012, FR-013): a heavy rule in the
// stage colour, the chapter number, the heading, the draft mark and text, then
// the stage's visual panel. Slot content spans the full width below both.
import type { StageId, StoryStage } from "../types.ts";
import DraftMark from "../shared/DraftMark.astro";
import StickyVisual from "./StickyVisual.astro";
import "../shared/stage-accents.css";
import "./c.css";

interface Props {
  stage: StoryStage;
  number: number;
  total?: number;
}
const { stage, number, total = 7 } = Astro.props;
const headingId = `${stage.id}-heading`;
const stageClass: `stage-${StageId}` = `stage-${stage.id}`;
---

<section id={stage.id} aria-labelledby={headingId} data-stage={stage.id} class:list={["cc-chapter", stageClass]}>
  <div class:list={["cc-grid", stage.visual && "cc-grid--visual"]}>
    <div class="cc-text">
      <div class="cc-head" data-reveal>
        <p class="cc-num">Chapter {number} of {total}</p>
        <h2 id={headingId} class="cc-heading">{stage.heading}</h2>
      </div>
      <p class="mb-3"><DraftMark /></p>
      {stage.body.map((p) => <p class="mb-3">{p}</p>)}
    </div>
    {stage.visual && <StickyVisual visual={stage.visual} idPrefix={`${stage.id}-visual`} />}
  </div>
  <div class="cc-after"><slot /></div>
</section>
