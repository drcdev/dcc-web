---
// Feature image at the top of a page (port of Flux content-feature-image.hbs;
// contracts/page-dom.md). `<Image />` from astro:assets adds width, height,
// lazy loading and a srcset for responsive sizes
// (docs.astro.build/en/guides/images/#astro-components-for-images).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="m-0">
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1024]}
    sizes="(min-width: 1024px) 1024px, 100vw"
    class="h-auto w-full rounded-xl"
  />
  {caption && <figcaption class="mt-2 text-sm text-dusk-600 dark:text-dusk-400">{caption}</figcaption>}
</figure>
