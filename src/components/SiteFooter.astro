---
// Site footer: site name, legal links, copyright, theme switch and social
// links (port of Flux layout-footer.hbs; contracts/shell-dom.md "Footer";
// research R4, R15; FR-008, FR-008a, FR-010a). Flux's Subscribe/Account link
// and Facebook/X icons are left out (FR-004). The year is the build year.
import { site } from "../config/site";
import { footerNavigation, socialNavigation } from "../config/navigation";
import ThemeToggle from "./ThemeToggle.astro";
import GitHubIcon from "../icons/github.svg";
import LinkedInIcon from "../icons/linkedin.svg";

const year = new Date().getFullYear();
const icons = { GitHub: GitHubIcon, LinkedIn: LinkedInIcon } as const;
---

<footer class="dark:bg-dusk-900">
  <div class="mx-auto w-full max-w-screen-lg p-4">
    <div class="items-center px-2 sm:flex sm:justify-between">
      <a href="/" class="mb-4 flex items-center justify-center sm:mb-0">
        <span class="self-center text-xl font-semibold whitespace-nowrap text-dusk-900 dark:text-white">{site.name}</span>
      </a>
      <ul
        class="mb-6 flex flex-wrap items-center justify-center text-sm font-medium text-dusk-500 sm:mb-0 dark:text-dusk-400"
      >
        {
          footerNavigation.map((item) => (
            <li class="px-2">
              <a href={item.href} class="hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <hr class="mx-auto my-2 border-dusk-200 lg:my-4 dark:border-dusk-700" />

    <div class="px-2 sm:flex sm:items-center sm:justify-between">
      <p class="block text-center text-sm text-mauve-600 dark:text-mauve-400">
        © {year} {site.name}. All rights reserved.
      </p>
      <div class="mt-4 flex justify-center sm:mt-0">
        <ThemeToggle />
        <div class="mx-2 hidden border-l border-dusk-200 js:block dark:border-dusk-700"></div>
        {
          socialNavigation.map((item) => {
            const Icon = icons[item.label as keyof typeof icons];
            return (
              <a href={item.href} class="mx-2 text-dusk-500 hover:text-dusk-900 dark:hover:text-white">
                <Icon class="size-6" aria-hidden="true" />
                <span class="sr-only">{item.label}</span>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</footer>
