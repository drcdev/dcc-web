---
// A titled block of text. A plain <section> with no accessible name, so it is
// not a landmark (FR-013; contracts/sections.md).
import { checkSection } from "./validate.ts";

export interface Props {
  title: string;
}

const html = (await Astro.slots.render("default")) ?? "";
checkSection("TextBlock", Astro.props, html, Astro.locals);
---

<section>
  <h2>{Astro.props.title}</h2>
  <Fragment set:html={html} />
</section>
