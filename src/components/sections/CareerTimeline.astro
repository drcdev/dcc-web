---
// The About page's career timeline (specs/041-career-timeline; contracts/timeline-markup.md): the
// career steps as an ordered list of native <details> disclosures, closed by default. The steps
// come from src/content/career/ through getCareerTimeline(); a `timeline` prop replaces the lookup,
// which is how the component tests feed it. Renders nothing when there are no steps. Everything
// here works without JavaScript. Text is rendered as text, never as markup (FR-003b), no style
// attribute is set (CSP, FR-017a), and nothing animates (FR-015).
import { getCareerTimeline } from "../../lib/career.ts";
import { formatMonth, type Timeline } from "../../lib/content/career.ts";

export interface Props {
  timeline?: Timeline;
}

const timeline = Astro.props.timeline ?? (await getCareerTimeline());

const link =
  "font-medium text-dusk-900 underline underline-offset-4 hover:text-rust-700 dark:text-white dark:hover:text-rust-400";
const listHeading = "mb-1 mt-4 text-base font-bold text-dusk-900 dark:text-white";
const list = "m-0 list-disc pl-6 [overflow-wrap:anywhere]";
---

{
  timeline.steps.length > 0 && (
    <section aria-labelledby="career-heading" data-career class="not-prose my-10">
      <h3 id="career-heading" class="mb-4 mt-0 text-2xl font-bold text-dusk-900 dark:text-white">
        Career
      </h3>
      <ol data-career-steps class="m-0 list-none p-0">
        {timeline.steps.map((step) => (
          <li data-step={step.id} class="m-0 border-t border-dusk-200 last:border-b dark:border-dusk-700 forced-colors:border-[CanvasText]">
            <details class="group print:details-content:block print:details-content:[content-visibility:visible]">
              <summary class="min-h-11 cursor-pointer py-2 text-dusk-900 dark:text-white">
                <span data-step-role class="block font-bold [overflow-wrap:anywhere]">
                  {step.role}
                </span>
                <span data-step-org class="block [overflow-wrap:anywhere]">
                  {step.organization}
                </span>
                <span data-step-period class="block text-sm text-dusk-600 dark:text-dusk-300">
                  <time datetime={step.start}>{formatMonth(step.start)}</time>{" "}
                  <span aria-hidden="true">{"–"}</span>
                  <span class="sr-only">to</span>{" "}
                  {step.end === "present" ? "present" : <time datetime={step.end}>{formatMonth(step.end)}</time>}
                </span>
              </summary>
              <div data-step-detail class="pb-4 pl-4 text-dusk-700 dark:text-mist-300">
                <dl class="m-0">
                  {step.parts.map((part) => (
                    <>
                      <dt class="mt-3 font-bold text-dusk-900 first:mt-0 dark:text-white">{part.label}</dt>
                      <dd class="m-0 [overflow-wrap:anywhere]">{part.text}</dd>
                    </>
                  ))}
                </dl>
                {step.achievements.length > 0 && (
                  <>
                    <h4 class={listHeading}>Achievements</h4>
                    <ul data-list="achievements" class={list}>
                      {step.achievements.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </>
                )}
                {step.leadership.length > 0 && (
                  <>
                    <h4 class={listHeading}>Leadership</h4>
                    <ul data-list="leadership" class={list}>
                      {step.leadership.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </>
                )}
                {step.posts.length > 0 && (
                  <>
                    <h4 class={listHeading}>Writing</h4>
                    <ul data-list="posts" class={list}>
                      {step.posts.map((post) => (
                        <li>
                          <a href={post.href} class={link}>
                            {post.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
                {step.awards.length > 0 && (
                  <>
                    <h4 class={listHeading}>Awards</h4>
                    <ul data-list="awards" class={list}>
                      {step.awards.map((award) => (
                        <li>
                          {award.href ? (
                            <>
                              <a href={award.href} class={link}>
                                {award.name}
                              </a>{" "}
                              ({award.year})
                            </>
                          ) : (
                            `${award.name} (${award.year})`
                          )}
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>
  )
}
