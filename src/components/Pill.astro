---
// The site's one label pill (FR-017): a plain label with a decorative tone and an
// optional link. Shared with the blog feature; project status and themes use it.
// Text carries the meaning; the tone is only a border and background, so nothing
// depends on colour alone. Palette tokens only, AA in both themes.
export interface Props {
  tone?: "neutral" | "sage" | "lavender" | "rust";
  href?: string;
}
const { tone = "neutral", href, ...rest } = Astro.props;
const tones = {
  neutral: "border-mauve-700 bg-white text-dusk-900 dark:border-mauve-300 dark:bg-dusk-900 dark:text-mist-100",
  sage: "border-sage-800 bg-sage-50 text-sage-950 dark:border-sage-300 dark:bg-dusk-900 dark:text-sage-100",
  lavender:
    "border-lavender-800 bg-lavender-50 text-lavender-950 dark:border-lavender-300 dark:bg-dusk-900 dark:text-lavender-100",
  rust: "border-rust-800 bg-rust-50 text-rust-950 dark:border-rust-300 dark:bg-dusk-900 dark:text-rust-100",
};
const shape = "not-prose inline-block rounded border px-2 py-0.5 text-xs font-semibold";
const Tag = href ? "a" : "span";
---

<Tag
  data-pill
  data-tone={tone}
  href={href}
  class:list={[shape, tones[tone], href && "underline underline-offset-2"]}
  {...rest}><slot /></Tag
>
