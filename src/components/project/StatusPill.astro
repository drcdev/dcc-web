---
// Project status as text in the shared pill (FR-017, FR-025). The tone is
// decorative; the word is what carries the status.
import Pill from "../Pill.astro";

export interface Props {
  status: "shipped" | "experiment" | "in-progress";
}
const { status } = Astro.props;
const label = { shipped: "Shipped", experiment: "Experiment", "in-progress": "In progress" }[status];
const tone = { shipped: "sage", experiment: "lavender", "in-progress": "rust" } as const;
---

<Pill tone={tone[status]} data-status={status}>{label}</Pill>
