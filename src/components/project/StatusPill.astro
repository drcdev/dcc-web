---
// Project status as text in the shared pill (FR-017, FR-025). The tone is
// decorative; the word is what carries the status.
import Pill from "../Pill.astro";
import type { ProjectStatus } from "../../content/collections/project-rules";
import { statusLabel, statusTone } from "../../lib/content/project-status";

export interface Props {
  status: ProjectStatus;
}
const { status } = Astro.props;
---

<Pill tone={statusTone(status)} data-status={status}>{statusLabel(status)}</Pill>
