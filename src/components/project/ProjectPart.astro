---
// One of the four parts of a project story. The parts plugin (src/lib/markdown/project-parts.ts)
// wraps each `##` heading and the text after it in this component; the story route passes it to
// <Content components>. The text sits in the post's prose classes, and a picture the project
// assigned to this part sits in a second column that wraps below the text on a phone
// (contracts/pages-dom.md). Build also shows the project's links after its text.
import { PageContentError, contentError } from "../../lib/content/errors.ts";
import { partIds, type PartId } from "../../lib/content/parts.ts";
import { proseClasses } from "../../lib/prose.ts";
import BuildLinks from "./BuildLinks.astro";
import PartPicture from "./PartPicture.astro";
import "./portfolio.css";

export interface Props {
  name: string;
}

const project = Astro.locals.project;
if (!project) throw new PageContentError("<ProjectPart> can only be used inside a project story (no project is set)");
const name = Astro.props.name as PartId;
if (!partIds.includes(name)) {
  throw contentError("project", project.file, `the part "${name}" is not one of ${partIds.join(", ")}.`);
}
const pictureOf = (part: PartId) =>
  Object.entries(project.data.visuals ?? {}).find(([, picture]) => picture.part === part)?.[0];
const picture = pictureOf(name);
// The first picture on the page, reading the parts in order, is the only eager one.
const eager = picture !== undefined && partIds.find((part) => pictureOf(part) !== undefined) === name;
---

<section data-part={name} aria-labelledby={name} data-has-picture={picture ? "true" : "false"}>
  <div data-part-text class:list={[proseClasses, "max-w-none"]}>
    <slot />
    {name === "build" && <BuildLinks />}
  </div>
  {picture && <PartPicture name={picture} eager={eager} />}
</section>
