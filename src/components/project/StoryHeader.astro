---
// The top of a project story: the title as the page's one h1, the problem line,
// status and themes (contracts/pages-dom.md). A draft shows a notice in plain text.
import type { ProjectStatus } from "../../lib/content/project-status";
import StatusPill from "./StatusPill.astro";
import ThemePills from "./ThemePills.astro";
import "./portfolio.css";

export interface Props {
  title: string;
  problem: string;
  status: ProjectStatus;
  themes: readonly string[];
  /** A draft is shown outside the production build only; the notice says so. */
  draft?: boolean;
  /** Names the h1 for the view transition from the index row; see TitleTransition. */
  slug?: string;
}

const { title, problem, status, themes, draft = false, slug } = Astro.props;
---

{
  draft && (
    <p data-draft-notice class="not-prose">
      <strong>Draft.</strong> This project is not published yet and will change.
    </p>
  )
}
<header data-story-header>
  <h1 data-story-title data-title-slug={slug}>{title}</h1>
  <p data-story-problem>{problem}</p>
  <div data-story-meta>
    <StatusPill status={status} />
    <ThemePills themes={themes} />
  </div>
</header>
