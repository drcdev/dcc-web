---
// <Demo />: the link forms of the built chapter (data-model.md "Demo and
// StandIn"): an open-demo link, or a stand-in link with the not-a-live-demo
// note, plus the source-code link. All same-tab plain links.
//
// <Demo frame /> (used by <Chapter visual="demo">, never written by hand) renders
// the embedded demo instead: a lazy, sandboxed <iframe> with a title, the
// referrer trimmed to the origin and no `allow` attribute, so the frame cannot
// autoplay, or reach the camera, microphone or location (contracts/pages-dom.md;
// research R10). The open-demo link stays in the built chapter, outside the frame.
// The story route allows drc.dev frames in the page policy for a project that embeds.
import { projectFileError } from "../../../lib/content/errors.ts";
import { checkProps, currentProject } from "./context.ts";
import "../portfolio.css";

const project = currentProject("Demo", Astro.locals);
const { frame } = checkProps("Demo", Astro.props, project);
const { title, demo, standIn, source } = project.data;
if (frame && !demo?.embed) {
  throw projectFileError(project.file, 'the chapter uses visual="demo", so demo needs embed: true.');
}
---

{
  frame && demo ? (
    <iframe
      src={demo.href}
      title={`${demo.title ?? title} demo`}
      loading="lazy"
      sandbox="allow-scripts allow-same-origin allow-forms"
      referrerpolicy="strict-origin-when-cross-origin"
      data-demo-frame
    />
  ) : (
    <ul data-demo-links>
      {
        demo && (
          <li>
            <a href={demo.href}>Open the {demo.title ?? title} demo</a>
          </li>
        )
      }
      {
        standIn && (
          <li>
            <a href={standIn.href}>{standIn.label ?? `${title} on drc.dev`}</a>{" "}
            <span data-demo-note>This is not a live demo.</span>
          </li>
        )
      }
      {
        source && (
          <li>
            <a href={source}>Source code for {title}</a>
          </li>
        )
      }
    </ul>
  )
}
