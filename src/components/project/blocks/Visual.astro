---
// <Visual name="…" />: a named visual from the project's `visuals` as a figure
// (data-model.md "IndexVisual / Visual"; contracts/pages-dom.md). Images carry
// alt text, diagrams and clips a visible description, and a clip is never
// autoplaying. Only the first visual on a page is eager.
import { Image } from "astro:assets";
import { projectFileError } from "../../../lib/content/errors.ts";
import { checkProps, currentProject, findVisual } from "./context.ts";
import "../portfolio.css";

export interface Props {
  name: string;
  eager?: boolean;
  idPrefix?: string;
}

const project = currentProject("Visual", Astro.locals);
const { name, eager = false, idPrefix = "visual" } = checkProps("Visual", Astro.props, project);
const visual = findVisual("Visual", name, project);
const loading = eager ? "eager" : "lazy";
const describedBy = `${idPrefix}-${name}-description`;

// A clip is emitted as a hashed asset by Vite. That it exists and is within 5 MB is
// checked when the collection loads (src/lib/content/project-images.ts), before
// this runs. The glob is lazy and only the clip on this page is awaited, so a clip
// no built page uses (a draft's, in the production build) is not emitted.
const clipFiles = import.meta.glob<string>("/src/content/projects/**/*.{webm,mp4}", {
  query: "?url",
  import: "default",
});
let clipSrc: string | undefined;
if (visual.kind === "clip") {
  const load = clipFiles[`/src/content/projects/${visual.src.replace(/^\.\//, "")}`];
  if (!load) throw projectFileError(project.file, `the clip ${visual.src} was not found. Check the path (it is relative to the project file).`);
  clipSrc = await load();
}
---

<figure data-visual={visual.kind} data-visual-name={name}>
  {visual.placeholder && <p data-placeholder data-visual-mark class="text-sm font-semibold"><strong>Placeholder</strong></p>}
  {
    visual.kind === "clip" ? (
      <>
        <video controls muted playsinline preload="none" poster={(visual.poster as ImageMetadata).src} aria-describedby={describedBy}>
          <source src={clipSrc} />
        </video>
        <figcaption id={describedBy}>
          <strong>{visual.label}.</strong> {visual.description}
        </figcaption>
      </>
    ) : (
      <>
        <Image
          src={visual.src as ImageMetadata}
          alt={visual.alt}
          loading={loading}
          decoding={eager ? "sync" : "async"}
          widths={[480, 800]}
          sizes="(min-width: 64rem) 26rem, 100vw"
          aria-describedby={visual.kind === "diagram" ? describedBy : undefined}
        />
        {visual.kind === "diagram" && <figcaption id={describedBy}>{visual.description}</figcaption>}
      </>
    )
  }
</figure>
