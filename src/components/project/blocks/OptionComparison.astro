---
// <OptionComparison />: the constraints-by-options table of the options chapter
// (contracts/pages-dom.md). A plain data table with the full content in the HTML;
// no script. It scrolls inside a keyboard-reachable, named region at narrow widths.
// The chosen option is marked in text; fit is written out, with a decorative mark.
import { projectFileError } from "../../../lib/content/errors.ts";
import { checkProps, currentProject } from "./context.ts";
import "../portfolio.css";

const project = currentProject("OptionComparison", Astro.locals);
checkProps("OptionComparison", Astro.props, project);
const comparison = project.data.comparison;
if (!comparison) throw projectFileError(project.file, "<OptionComparison /> needs a comparison setting.");

const { constraints, options } = comparison;
const caption = comparison.caption ?? `How the options compare for ${project.data.title}`;
const chosen = options.find((option) => option.chosen);
const fitText = { meets: "Meets", partly: "Partly", misses: "Misses" } as const;
const fitMark = { meets: "✓ ", partly: "~ ", misses: "✗ " } as const;
const hasPros = options.some((option) => option.pros?.length);
const hasCons = options.some((option) => option.cons?.length);
---

<div role="region" aria-labelledby="options-caption" tabindex="0" data-comparison>
  <table>
    <caption id="options-caption">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">What to compare</th>
        {
          options.map((option) => (
            <th scope="col" data-chosen={option.chosen ? "" : undefined}>
              {option.name}
              {option.chosen && <span data-chosen-label>Chosen</span>}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">Summary</th>
        {options.map((option) => <td data-chosen={option.chosen ? "" : undefined}>{option.summary}</td>)}
      </tr>
      {
        hasPros && (
          <tr>
            <th scope="row">In its favour</th>
            {options.map((option) => (
              <td data-chosen={option.chosen ? "" : undefined}>
                {option.pros?.length ? <ul>{option.pros.map((item) => <li>{item}</li>)}</ul> : null}
              </td>
            ))}
          </tr>
        )
      }
      {
        hasCons && (
          <tr>
            <th scope="row">Against it</th>
            {options.map((option) => (
              <td data-chosen={option.chosen ? "" : undefined}>
                {option.cons?.length ? <ul>{option.cons.map((item) => <li>{item}</li>)}</ul> : null}
              </td>
            ))}
          </tr>
        )
      }
      {
        constraints.map((constraint) => (
          <tr>
            <th scope="row">
              {constraint.label}
              {constraint.detail && (
                <>
                  {" "}
                  <small>{constraint.detail}</small>
                </>
              )}
            </th>
            {options.map((option) => {
              const fit = option.fit[constraint.id] as keyof typeof fitText;
              return (
                <td data-chosen={option.chosen ? "" : undefined} data-fit={fit}>
                  <span aria-hidden="true">{fitMark[fit]}</span>
                  {fitText[fit]}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
{
  chosen && (
    <p data-reason>
      <strong>Why {chosen.name} was chosen.</strong> {chosen.reason}
    </p>
  )
}
