---
// A picture from the project's `visuals`, shown beside the part it names (data-model.md
// "Visual"; contracts/pages-dom.md). Images carry alt text and diagrams a visible description.
// Only the first picture on a page is eager.
import { Image } from "astro:assets";
import { PageContentError, contentError } from "../../lib/content/errors.ts";
import "./portfolio.css";

export interface Props {
  name: string;
  eager?: boolean;
}

const project = Astro.locals.project;
if (!project) throw new PageContentError("<PartPicture> can only be used inside a project story (no project is set)");
const { name, eager = false } = Astro.props;
const picture = project.data.visuals?.[name];
if (!picture) {
  const known = Object.keys(project.data.visuals ?? {});
  throw contentError("project", project.file, `the picture "${name}" is not in visuals (${known.length ? known.join(", ") : "none defined"}).`);
}
const describedBy = `picture-${name}-description`;
---

<figure data-part-picture data-visual={picture.kind} data-visual-name={name}>
  <Image
    src={picture.src as ImageMetadata}
    alt={picture.alt}
    loading={eager ? "eager" : "lazy"}
    decoding={eager ? "sync" : "async"}
    widths={[480, 800]}
    sizes="(min-width: 64rem) 26rem, 100vw"
    aria-describedby={picture.kind === "diagram" ? describedBy : undefined}
  />
  {picture.kind === "diagram" && <figcaption id={describedBy}>{picture.description}</figcaption>}
</figure>
