---
// The author part of the post footer (specs/039-post-author-card; contracts/author-card.md; box and
// views note moved by specs/045-post-footer-consolidation). It has no box of its own: PostFooter
// draws the one box. The views note sits last in the text column, a caption after the links. The wording and the photo come from blog.author. The
// photo is last in the DOM so a screen reader meets the heading and lines first; `order-first`
// puts it first visually. Photo: Astro's <Image /> at 96 px with 1x and 2x WebP candidates
// (docs.astro.build/en/guides/images/; research R2). Below md everything is centred and stacked;
// from md the photo sits left of left-aligned text, the same breakpoint as the views note and Share.
import { Image } from "astro:assets";
import portrait from "../../content/pages/images/don-coleman.jpg";
import { blog } from "../../config/blog.ts";
import ViewsNote from "./ViewsNote.astro";
import { findTopic, seriesOf, topicHref } from "../../config/topics.ts";

export interface Props {
  /** The post's topic ids; the writing link reads the series from them. */
  topics: readonly string[];
}

const { author } = blog;
const series = seriesOf(Astro.props.topics);
const writing = series
  ? { href: topicHref(series), text: `More in ${findTopic(series)!.name}` }
  : { href: "/writing/", text: "More of my writing" };
const links = [writing, { href: "/about/", text: "More about me" }, { href: "/contact/", text: "Get in touch" }];
const linkClass =
  "inline-block px-1 py-1 font-medium text-dusk-900 underline underline-offset-4 hover:text-rust-700 dark:text-white dark:hover:text-rust-400";
---

<section
  data-author-card
  class="flex flex-col items-center gap-4 text-center md:flex-row md:items-start md:gap-6 md:text-left"
>
  <div class="min-w-0 flex-1 [overflow-wrap:anywhere]">
    <h2 class="m-0 mb-2 text-lg font-bold text-dusk-900 dark:text-white">Written by {author.name}</h2>
    {author.lines.map((line) => <p class="m-0 mb-2 text-dusk-700 dark:text-mist-300">{line}</p>)}
    <ul class="m-0 mt-3 flex list-none flex-wrap justify-center gap-x-4 gap-y-2 p-0 md:justify-start">
      {links.map((link) => <li><a href={link.href} class={linkClass}>{link.text}</a></li>)}
    </ul>
    <ViewsNote />
  </div>
  <Image
    src={portrait}
    alt={author.photoAlt}
    width={96}
    height={96}
    densities={[1, 2]}
    format="webp"
    loading="lazy"
    class="order-first h-24 w-24 shrink-0 rounded-full object-cover"
  />
</section>
