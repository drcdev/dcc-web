---
// A row of links to every topic and to all posts.
import { topics, listingPath, type DirectionId } from "../_data/samples.ts";
import TopicPill from "./TopicPill.astro";

export interface Props {
  direction: DirectionId;
  label?: string;
  exclude?: string;
  variant?: "pill" | "text";
}

const { direction, label = "Topics", exclude, variant = "pill" } = Astro.props;
---

<nav aria-label={label} class="my-6">
  <ul class="flex flex-wrap items-center gap-3">
    {
      topics
        .filter((t) => t.slug !== exclude)
        .map((t) => (
          <li>
            <TopicPill direction={direction} slug={t.slug} variant={variant} />
          </li>
        ))
    }
    <li>
      <a class="font-semibold text-accent-700 underline hover:no-underline dark:text-accent-300" href={listingPath(direction, 1)}>All posts</a>
    </li>
  </ul>
</nav>
