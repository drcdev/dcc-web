---
// The note every prototype page opens with (contracts/prototype-routes.md,
// "Every prototype page MUST" 3): says this is not the published blog and links
// to the directions index and to the same screen in the other directions.
import { directions, type DirectionId } from "../_data/samples.ts";
import { INDEX_PATH, directionLabel, screenPath, type Screen } from "../_data/screens.ts";

export interface Props {
  direction?: DirectionId;
  screen: Screen;
}

const { direction, screen } = Astro.props;
const others = direction ? directions.filter((d) => d.id !== direction) : [];
---

<aside
  data-prototype-notice
  aria-label="Prototype notice"
  class="mb-8 rounded-lg border border-dusk-300 bg-mist-100 p-4 text-sm text-dusk-900 dark:border-dusk-600 dark:bg-dusk-800 dark:text-mist-100"
>
  <p><strong>Design prototype for review.</strong> This is not the published blog.</p>
  <nav aria-label="Prototype directions" class="mt-2">
    <ul class="flex flex-wrap gap-x-4 gap-y-1">
      <li><a class="underline hover:no-underline" href={INDEX_PATH}>All directions</a></li>
      {
        others.map((other) => (
          <li>
            <a class="underline hover:no-underline" href={screenPath(other.id, screen)} data-other-direction={other.id}>
              Same screen in {directionLabel(other.id)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>
