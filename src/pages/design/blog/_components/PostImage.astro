---
// A sample feature image: the imported SVG renders inline, so it carries its own
// role and accessible name (Astro 7 SVG components).
import { sampleImages } from "../_data/images.ts";
import type { SamplePost } from "../_data/samples.ts";

export interface Props {
  post: SamplePost;
  class?: string;
}

const { post, class: className } = Astro.props;
const Image = post.image ? sampleImages[post.image.id] : undefined;
---

{Image && post.image && <Image role="img" aria-label={post.image.alt} class:list={["block h-auto w-full", className]} />}
