---
// Page shell for every direction page: the site layout (unchanged navigation),
// noindex, no canonical, a "Prototype" title and the prototype notice.
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getNavigation } from "../../../../lib/pages";
import PrototypeNotice from "./PrototypeNotice.astro";
import type { DirectionId } from "../_data/samples.ts";
import type { Screen } from "../_data/screens.ts";

export interface Props {
  title: string;
  description: string;
  direction: DirectionId;
  screen: Screen;
}

const { title, description, direction, screen } = Astro.props;
const navigation = await getNavigation();
---

<BaseLayout title={title} description={description} navigation={navigation} noindex canonical={false}>
  <PrototypeNotice direction={direction} screen={screen} />
  <slot />
</BaseLayout>
