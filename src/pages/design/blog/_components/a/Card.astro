---
// Direction A post card: feature image on top (a tone-coloured top rule when the
// post has no image), title, summary and meta.
import PostImage from "../PostImage.astro";
import PostMeta from "../PostMeta.astro";
import { postPath, topicBySlug, type SamplePost } from "../../_data/samples.ts";
import { toneBorder } from "../../_data/tones.ts";

export interface Props {
  post: SamplePost;
  level?: "h2" | "h3";
  large?: boolean;
  class?: string;
}

const { post, level = "h3", large = false, class: className } = Astro.props;
const Heading = level;
const tone = topicBySlug(post.topics[0]!).tone;
---

<article
  class:list={[
    "flex h-full min-w-0 flex-col overflow-hidden rounded-xl border border-t-4 bg-white dark:bg-dusk-800",
    post.image ? "border-dusk-200 dark:border-dusk-700" : toneBorder[tone],
    className,
  ]}
>
  <PostImage post={post} class={large ? "md:h-full md:min-h-48 md:object-cover" : ""} />
  <div class="flex flex-1 flex-col gap-3 p-5">
    <Heading
      class:list={["font-bold text-dusk-900 [overflow-wrap:anywhere] dark:text-white", large ? "text-2xl md:text-3xl" : "text-xl"]}
    >
      <a class="inline-block min-h-6 hover:underline" href={postPath("a", post)}>{post.title}</a>
    </Heading>
    <p class="text-dusk-700 dark:text-mist-300">{post.summary}</p>
    <PostMeta post={post} direction="a" class="mt-auto pt-2" />
  </div>
</article>
