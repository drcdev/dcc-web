---
// Date, reading time, featured marker and topics for one post (FR-009). Used by
// every post presentation in every direction.
import type { DirectionId, SamplePost } from "../_data/samples.ts";
import { formatDate } from "../_data/screens.ts";
import TopicPill from "./TopicPill.astro";

export interface Props {
  post: SamplePost;
  direction: DirectionId;
  topicVariant?: "pill" | "text";
  class?: string;
}

const { post, direction, topicVariant = "pill", class: className } = Astro.props;
---

<div class:list={["flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-dusk-700 dark:text-mist-300", className]}>
  {
    post.featured && (
      <span
        data-featured
        class="rounded border border-rust-700 px-2 py-0.5 text-xs font-semibold uppercase tracking-wide text-rust-800 dark:border-rust-300 dark:text-rust-200"
      >
        Featured
      </span>
    )
  }
  <time datetime={post.date}>{formatDate(post.date)}</time>
  <span aria-hidden="true">·</span>
  <span>{post.readingMinutes} min read</span>
  <ul class="flex flex-wrap gap-2" aria-label="Topics">
    {
      post.topics.map((slug) => (
        <li>
          <TopicPill direction={direction} slug={slug} variant={topicVariant} />
        </li>
      ))
    }
  </ul>
</div>
