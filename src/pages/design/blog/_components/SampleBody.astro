---
// The sample post body (FR-010, research R2, R4): inside the site's prose
// wrapper, with a figure and caption, plain code in a focusable scroll region
// and a wide table in the existing .table-wrapper. The "short" variant is a
// brief body; "full-no-image" omits only the feature image (rendered by the
// post page), so the in-body figure stays.
import { posts, postPath, type BodyKind, type DirectionId, type SamplePost } from "../_data/samples.ts";
import { fullBodies, shortBodies } from "../_data/bodies.ts";
import Figure from "../_images/records.svg";
import { bodySections } from "../_data/screens.ts";

export interface Props {
  variant: BodyKind;
  post: SamplePost;
  direction: DirectionId;
}

const { variant, post, direction } = Astro.props;
const full = variant !== "short";
const [found, check, cost, leaves] = bodySections;
const fullText = fullBodies[post.slug];
const shortText = shortBodies[post.slug] ?? [];
// Short bodies end with a route to the full sample post (research R2).
const fullPost = posts.find((p) => p.body === (post.image ? "full-with-image" : "full-no-image"))!;
---

<div class="prose prose-lg max-w-none dark:prose-invert prose-accent" data-sample-body={variant}>
  {full && fullText ? fullText.opening.map((text) => <p>{text}</p>) : null}
  {
    full && fullText ? (
      <>
        <h2 id={found.id}>{found.title}</h2>
        <p>{fullText.found}</p>
        <figure>
          <Figure role="img" aria-label="Four rows of records, each with a short highlighted entry." class="h-auto w-full" />
          <figcaption>Four record types, and the one entry in each that other teams read.</figcaption>
        </figure>
        <h2 id={check.id}>{check.title}</h2>
        <p>{fullText.check}</p>
        <pre tabindex="0" role="region" aria-label="Code sample: row count check" class="overflow-x-auto focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 dark:focus-visible:outline-accent-400">
          <code>{`select source.entity, source.row_count, target.row_count from nightly_counts source join nightly_counts target on target.entity = source.entity and target.system = 'reporting' where source.system = 'operational' and source.row_count <> target.row_count;`}</code>
        </pre>
        <h2 id={cost.id}>{cost.title}</h2>
        <p>{fullText.cost}</p>
        <div class="table-wrapper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 dark:focus-visible:outline-accent-400" tabindex="0" role="region" aria-label="Table: effort and protection by step">
          <table>
            <caption class="p-2 text-left text-sm">Effort and protection by step</caption>
            <thead>
              <tr>
                <th scope="col">Step</th>
                <th scope="col">Effort</th>
                <th scope="col">Owner</th>
                <th scope="col">What it protects</th>
                <th scope="col">How often</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Write down the jobs</td>
                <td>Two afternoons</td>
                <td>Team lead</td>
                <td>Reports that depend on old jobs</td>
                <td>Once, then yearly</td>
              </tr>
              <tr>
                <td>Compare row counts</td>
                <td>One sprint</td>
                <td>Data engineer</td>
                <td>Silent data loss between systems</td>
                <td>Every night</td>
              </tr>
              <tr>
                <td>Review the retention rules</td>
                <td>One meeting</td>
                <td>Privacy officer</td>
                <td>Keeping data longer than promised</td>
                <td>Every quarter</td>
              </tr>
            </tbody>
          </table>
        </div>
        <h2 id={leaves.id}>{leaves.title}</h2>
        <p>{fullText.closing}</p>
      </>
    ) : (
      <>
        {shortText.map((text) => (
          <p>{text}</p>
        ))}
        <p>
          <a href={postPath(direction, fullPost)} data-full-post>
            Read a longer post with a figure, a code sample and a table: {fullPost.title}
          </a>
        </p>
      </>
    )
  }
</div>
