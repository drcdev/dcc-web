---
import Shell from "../_components/Shell.astro";
import Eyebrow from "../_components/Eyebrow.astro";
import PostImage from "../_components/PostImage.astro";
import PostMeta from "../_components/PostMeta.astro";
import SampleBody from "../_components/SampleBody.astro";
import { byNewest, posts, postPath, relatedTo } from "../_data/samples.ts";

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const index = byNewest.findIndex((p) => p.slug === post.slug);
const newer = byNewest[index - 1];
const older = byNewest[index + 1];
const link = "font-semibold text-accent-700 underline hover:no-underline dark:text-accent-300";
---

<Shell
  title={`Prototype B · Post: ${post.title}`}
  description={post.summary}
  direction="b"
  screen={{ kind: "post", post }}
>
  <div class="mx-auto max-w-3xl">
    <article>
      <header class="mb-8">
        <Eyebrow />
        <h1 class="mb-3 text-3xl font-bold text-dusk-900 [overflow-wrap:anywhere] dark:text-white md:text-4xl">{post.title}</h1>
        <PostMeta post={post} direction="b" topicVariant="text" />
        <p class="mt-4 text-lg text-dusk-700 dark:text-mist-300">{post.summary}</p>
        {post.image && <PostImage post={post} class="mt-6 rounded-lg" />}
      </header>
      <SampleBody variant={post.body} post={post} direction="b" />
    </article>
    <section aria-labelledby="related" class="mt-12 border-t border-dusk-200 pt-8 dark:border-dusk-700">
      <h2 id="related" class="mb-4 text-2xl font-bold text-dusk-900 dark:text-white">Related posts</h2>
      <ul class="space-y-4">
        {
          relatedTo(post).map((related) => (
            <li>
              <a class="text-lg font-semibold text-dusk-900 underline hover:no-underline [overflow-wrap:anywhere] dark:text-white" href={postPath("b", related)}>
                {related.title}
              </a>
              <p class="text-dusk-700 dark:text-mist-300">{related.summary}</p>
              <PostMeta post={related} direction="b" topicVariant="text" class="mt-2" />
            </li>
          ))
        }
      </ul>
    </section>
    <nav aria-label="Previous and next posts" class="mt-10 flex flex-wrap justify-between gap-4">
      {newer ? <a class={link} href={postPath("b", newer)} rel="prev">Newer: {newer.title}</a> : <span></span>}
      {older ? <a class={link} href={postPath("b", older)} rel="next">Older: {older.title}</a> : <span></span>}
    </nav>
  </div>
</Shell>
