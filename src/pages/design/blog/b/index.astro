---
// Direction B, "Timeline": a short "Start here" list, then the newest-first
// stream grouped by month. Text first, no images.
import Shell from "../_components/Shell.astro";
import Eyebrow from "../_components/Eyebrow.astro";
import TopicRow from "../_components/TopicRow.astro";
import PostMeta from "../_components/PostMeta.astro";
import Timeline from "../_components/b/Timeline.astro";
import { byNewest, featuredPosts, listingPath, postPath } from "../_data/samples.ts";

const startHere = featuredPosts.slice(0, 3);
const stream = byNewest.slice(0, 8);
---

<Shell
  title="Prototype B · Writing landing page"
  description="Direction B, Timeline: a start-here list and a newest-first stream grouped by month."
  direction="b"
  screen={{ kind: "landing" }}
>
  <div class="mx-auto max-w-3xl">
    <Eyebrow />
    <h1 class="mb-1 text-4xl font-bold text-dusk-900 dark:text-white">Writing</h1>
    <p class="text-lg text-dusk-700 dark:text-mist-300">
      Notes on leading technology teams through regulated, long-lived systems. Newest first.
    </p>
    <section aria-labelledby="start-here" class="mb-6 mt-3 rounded-xl border border-dusk-200 p-4 dark:border-dusk-700 lg:-mx-28 xl:-mx-40">
      <h2 id="start-here" class="mb-2 text-xl font-bold text-dusk-900 dark:text-white">Start here</h2>
      <ol class="list-decimal space-y-5 pl-6 marker:font-bold marker:text-dusk-700 dark:marker:text-mist-300 md:grid md:grid-cols-3 md:gap-6 md:space-y-0 md:pl-5">
        {
          startHere.map((post) => (
            <li>
              <h3 class="text-lg font-semibold text-dusk-900 [overflow-wrap:anywhere] dark:text-white md:text-base">
                <a class="inline-block min-h-6 hover:underline" href={postPath("b", post)}>{post.title}</a>
              </h3>
              <p class="mt-1 text-dusk-700 dark:text-mist-300 md:line-clamp-3">{post.summary}</p>
              <PostMeta post={post} direction="b" topicVariant="text" class="mt-1" />
            </li>
          ))
        }
      </ol>
    </section>
    <Timeline posts={stream} group="month" />
    <TopicRow direction="b" variant="text" label="Filter by topic" />
    <p>
      <a class="font-semibold text-accent-700 underline hover:no-underline dark:text-accent-300" href={listingPath("b", 1)}>
        Older posts and the full archive
      </a>
    </p>
  </div>
</Shell>
