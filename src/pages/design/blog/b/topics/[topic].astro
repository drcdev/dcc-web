---
import Shell from "../../_components/Shell.astro";
import Eyebrow from "../../_components/Eyebrow.astro";
import TopicRow from "../../_components/TopicRow.astro";
import Timeline from "../../_components/b/Timeline.astro";
import { postsInTopic, topics } from "../../_data/samples.ts";

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { topic: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const list = postsInTopic(topic.slug);
---

<Shell
  title={`Prototype B · Topic: ${topic.name}`}
  description={`Direction B, Timeline: posts on ${topic.name}, newest first.`}
  direction="b"
  screen={{ kind: "topic", topic: topic.slug }}
>
  <div class="mx-auto max-w-3xl">
    <Eyebrow />
    <h1 class="mb-3 text-4xl font-bold text-dusk-900 dark:text-white">{topic.name}</h1>
    <p class="mb-8 text-lg text-dusk-700 dark:text-mist-300">{topic.intro}</p>
    <Timeline posts={list} group="year" />
    <TopicRow direction="b" variant="text" label="Other topics" exclude={topic.slug} />
  </div>
</Shell>
