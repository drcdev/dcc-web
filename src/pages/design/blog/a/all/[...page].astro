---
import type { GetStaticPaths } from "astro";
import Shell from "../../_components/Shell.astro";
import Eyebrow from "../../_components/Eyebrow.astro";
import TopicRow from "../../_components/TopicRow.astro";
import Pagination from "../../_components/Pagination.astro";
import Card from "../../_components/a/Card.astro";
import { byNewest, PAGE_SIZE } from "../../_data/samples.ts";

export const getStaticPaths = (({ paginate }) => paginate(byNewest, { pageSize: PAGE_SIZE })) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Shell
  title={`Prototype A · All posts, page ${page.currentPage}`}
  description="Direction A, Front page: all posts as a card grid, newest first."
  direction="a"
  screen={{ kind: "listing", page: page.currentPage }}
>
  <Eyebrow />
  <h1 class="mb-2 text-4xl font-bold text-dusk-900 dark:text-white">All posts</h1>
  <p class="text-dusk-700 dark:text-mist-300">Newest first.</p>
  <TopicRow direction="a" />
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {page.data.map((post) => <Card post={post} level="h2" />)}
  </div>
  <Pagination direction="a" current={page.currentPage} last={page.lastPage} />
</Shell>
