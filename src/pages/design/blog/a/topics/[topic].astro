---
import Shell from "../../_components/Shell.astro";
import Eyebrow from "../../_components/Eyebrow.astro";
import TopicRow from "../../_components/TopicRow.astro";
import Card from "../../_components/a/Card.astro";
import { postsInTopic, topics } from "../../_data/samples.ts";
import { toneBanner } from "../../_data/tones.ts";

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { topic: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const list = postsInTopic(topic.slug);
---

<Shell
  title={`Prototype A · Topic: ${topic.name}`}
  description={`Direction A, Front page: posts on ${topic.name}.`}
  direction="a"
  screen={{ kind: "topic", topic: topic.slug }}
>
  <div class:list={["rounded-2xl p-6 md:p-10", toneBanner[topic.tone]]}>
    <Eyebrow />
    <h1 class="mb-3 text-3xl font-bold md:text-4xl">{topic.name}</h1>
    <p class="max-w-prose text-lg">{topic.intro}</p>
    <p class="mt-3 text-sm">{list.length} {list.length === 1 ? "post" : "posts"}</p>
  </div>
  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {list.map((post) => <Card post={post} level="h2" />)}
  </div>
  <TopicRow direction="a" label="Other topics" exclude={topic.slug} />
</Shell>
