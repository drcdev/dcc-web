---
import Shell from "../_components/Shell.astro";
import Eyebrow from "../_components/Eyebrow.astro";
import PostImage from "../_components/PostImage.astro";
import PostMeta from "../_components/PostMeta.astro";
import SampleBody from "../_components/SampleBody.astro";
import Card from "../_components/a/Card.astro";
import { posts, relatedTo, topicBySlug } from "../_data/samples.ts";
import { toneBorder } from "../_data/tones.ts";

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const tone = topicBySlug(post.topics[0]!).tone;
---

<Shell
  title={`Prototype A · ${post.title}`}
  description={post.summary}
  direction="a"
  screen={{ kind: "post", post }}
>
  <article>
    <header>
      {post.image && <PostImage post={post} class="rounded-2xl" />}
      <div
        class:list={[
          "relative rounded-2xl border border-t-4 bg-white p-6 dark:bg-dusk-800 md:p-8",
          post.image ? "mx-2 -mt-10 border-dusk-200 dark:border-dusk-700 md:mx-10 md:-mt-16" : toneBorder[tone],
        ]}
      >
        <Eyebrow />
        <h1 class="mb-3 text-3xl font-bold text-dusk-900 [overflow-wrap:anywhere] dark:text-white md:text-4xl">{post.title}</h1>
        <p class="mb-4 text-lg text-dusk-700 dark:text-mist-300">{post.summary}</p>
        <PostMeta post={post} direction="a" />
      </div>
    </header>
    <div class="mx-auto mt-8 max-w-3xl">
      <SampleBody variant={post.body} />
    </div>
  </article>
  <section aria-labelledby="related" class="mt-14">
    <h2 id="related" class="mb-4 text-2xl font-bold text-dusk-900 dark:text-white">Related posts</h2>
    <div class="grid gap-4 md:grid-cols-3">
      {relatedTo(post).map((related) => <Card post={related} />)}
    </div>
  </section>
</Shell>
