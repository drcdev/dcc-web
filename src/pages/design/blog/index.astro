---
// Directions index: the entry point to the three blog design prototypes
// (contracts/prototype-routes.md; FR-005, FR-017, SC-004). Not linked from the
// site, not in the sitemap, and removed after Don's review.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getNavigation } from "../../../lib/pages";
import PrototypeNotice from "./_components/PrototypeNotice.astro";
import { byNewest, directions, landingPath, listingPath, postPath } from "./_data/samples.ts";

const navigation = await getNavigation();
const sample = byNewest[0]!;
const link = "font-semibold text-accent-700 underline hover:no-underline dark:text-accent-300";
---

<BaseLayout
  title="Prototype · Blog design directions"
  description="Three design directions for the blog, for review. Not the published blog."
  navigation={navigation}
  noindex
  canonical={false}
>
  <PrototypeNotice screen={{ kind: "index" }} />
  <h1 class="my-4 text-4xl font-bold text-dusk-900 dark:text-white">Blog design directions</h1>
  <p class="mb-8 max-w-prose text-dusk-700 dark:text-mist-300">
    Three ways the Drift &amp; Convergence blog could look and be organised. Each has a landing page, a listing and a post
    page filled with sample posts. Open one, look at it in both themes and at phone and desktop width, then compare.
  </p>
  <div class="grid gap-6 lg:grid-cols-3">
    {
      directions.map((direction) => (
        <section
          data-direction={direction.id}
          aria-labelledby={`direction-${direction.id}`}
          class="rounded-lg border border-dusk-200 p-5 dark:border-dusk-700"
        >
          <h2 id={`direction-${direction.id}`} class="mb-3 text-2xl font-semibold text-dusk-900 dark:text-white">
            Direction {direction.id.toUpperCase()}: {direction.name}
          </h2>
          <p class="mb-3 text-dusk-700 dark:text-mist-300">{direction.summary}</p>
          <p class="mb-4 text-dusk-700 dark:text-mist-300">
            <strong>When no post is featured:</strong> <span data-role="no-featured">{direction.noFeaturedBehaviour}</span>
          </p>
          <ul class="space-y-2">
            <li>
              <a class={link} data-link="landing" href={landingPath(direction.id)}>
                Writing landing page
              </a>
            </li>
            <li>
              <a class={link} data-link="listing" href={listingPath(direction.id, 1)}>
                All posts listing
              </a>
            </li>
            <li>
              <a class={link} data-link="post" href={postPath(direction.id, sample)}>
                A post page
              </a>
            </li>
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
