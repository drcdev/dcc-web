---
// Portfolio design directions: the hub (prototype; removed before merge).
// One card per direction with routes to its index and its Focus Pocus story.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getNavigation } from "../../../lib/pages";
import { directions } from "../../../prototypes/portfolio/sample";
---

<BaseLayout
  title="Portfolio design directions"
  description="Design prototypes: three directions for the portfolio project story and index."
  navigation={await getNavigation()}
  noindex
>
  <p
    data-prototype-notice
    class="not-prose mb-6 rounded-lg border border-lavender-700 bg-lavender-50 px-4 py-3 text-sm text-dusk-900 dark:border-lavender-300 dark:bg-dusk-900 dark:text-white"
  >
    <strong>Design prototype for review.</strong> Not part of the live site.
  </p>
  <h1 class="mb-2 text-4xl font-bold text-dusk-900 dark:text-mist-100">Portfolio design directions</h1>
  <p class="mb-8 max-w-3xl text-dusk-800 dark:text-mist-200">
    Three ways to present a project story and the projects index, each built with the same sample content. Open a
    direction's index or its Focus Pocus story to compare.
  </p>
  <ul class="m-0 grid list-none gap-6 p-0 md:grid-cols-3">
    {
      directions.map((d) => (
        <li
          class="rounded-lg border border-dusk-800 bg-white p-6 dark:border-mist-200 dark:bg-dusk-900"
          data-direction={d.key}
        >
          <h2 class="mb-2 text-2xl font-bold text-dusk-900 dark:text-mist-100">
            Direction {d.key.toUpperCase()}: {d.name}
          </h2>
          <p class="mb-4 text-dusk-800 dark:text-mist-200">{d.summary}</p>
          <ul class="m-0 flex list-none flex-col gap-2 p-0">
            <li>
              <a
                class="inline-block min-h-6 underline underline-offset-2 text-dusk-900 dark:text-white"
                href={d.indexPath}
              >
                {d.name} projects index
              </a>
            </li>
            <li>
              <a
                class="inline-block min-h-6 underline underline-offset-2 text-dusk-900 dark:text-white"
                href={d.storyPath}
              >
                {d.name} Focus Pocus story
              </a>
            </li>
          </ul>
        </li>
      ))
    }
  </ul>
</BaseLayout>
