---
// The blog landing page, `/writing/` (spec 008 US2; contracts/blog-pages.md
// "Landing"; Direction A of docs/design/blog.md; FR-006 to FR-010, FR-047, FR-048).
// In order: eyebrow, `h1` and feed link; the lead story (the newest visible post);
// the topic pill row; Featured (up to three, never the lead story); Latest (up to
// six not already shown) with a link to all posts. Sections with nothing to show
// are left out. With no visible posts a plain message replaces them and the pill
// row stays. `selectLanding()` decides what shows; getPostSummaries() is the only
// reader of the posts collection, so drafts are left out of a production build.
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/post/CardGrid.astro";
import FeaturedGrid from "../../components/post/FeaturedGrid.astro";
import LeadStory from "../../components/post/LeadStory.astro";
import TopicPillRow from "../../components/post/TopicPillRow.astro";
import { blog } from "../../config/blog.ts";
import { selectLanding } from "../../lib/content/post-order.ts";
import { getNavigation } from "../../lib/pages";
import { getPostSummaries } from "../../lib/posts";

const navigation = await getNavigation();
const { lead, featured, latest } = selectLanding(await getPostSummaries());
const feedHref = new URL("/writing/rss.xml", Astro.site).href;
---

<BaseLayout title="Writing" description={blog.feedDescription} navigation={navigation}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={blog.feedTitle} href={feedHref} />
  <div class="mx-auto max-w-screen-lg">
    <header class="mb-8 flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
      <div>
        <p class="m-0 text-xs font-semibold uppercase tracking-wider text-rust-800 dark:text-rust-300">
          {blog.sectionName}
        </p>
        <h1 class="my-2 text-5xl font-bold break-words text-dusk-900 dark:text-white">Writing</h1>
      </div>
      <a
        href="/writing/rss.xml"
        class="inline-block px-1 py-1 font-medium text-dusk-900 underline underline-offset-4 hover:text-rust-700 dark:text-white dark:hover:text-rust-400"
        >Subscribe (RSS)</a
      >
    </header>

    {lead && <LeadStory post={lead} />}

    <div class="my-8">
      <TopicPillRow />
    </div>

    {
      lead ? (
        <>
          {
            featured.length > 0 && (
              <section class="mb-10">
                <h2 class="mb-4 mt-0 text-2xl font-bold text-dusk-900 dark:text-white">Featured</h2>
                <FeaturedGrid posts={featured} />
              </section>
            )
          }
          {
            latest.length > 0 && (
              <section class="mb-10">
                <h2 class="mb-4 mt-0 text-2xl font-bold text-dusk-900 dark:text-white">Latest</h2>
                <CardGrid posts={latest} headingLevel="h3" data-latest-grid="" />
                <p class="mt-6">
                  <a
                    href="/writing/all/"
                    class="inline-block px-1 py-1 font-medium text-dusk-900 underline underline-offset-4 hover:text-rust-700 dark:text-white dark:hover:text-rust-400"
                    >All posts</a
                  >
                </p>
              </section>
            )
          }
        </>
      ) : (
        <p class="text-lg text-dusk-700 dark:text-mist-300">There are no posts yet.</p>
      )
    }
  </div>
</BaseLayout>
