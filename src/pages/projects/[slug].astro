---
// The one route for every project story in src/content/projects/ (spec FR-002,
// FR-073). getStaticPaths() checks the body of every project, drafts included,
// then makes one path per published project
// (docs.astro.build/en/guides/content-collections/#generating-routes-from-content).
// The body is rendered with render() from astro:content; the parts plugin wraps its parts in
// ProjectPart and OptionsTable, which are handed to <Content /> so MDX needs no imports
// (docs.astro.build/en/guides/integrations-guide/mdx/#passing-components-to-mdx-content).
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import OptionsTable from "../../components/project/OptionsTable.astro";
import ProjectPart from "../../components/project/ProjectPart.astro";
import { assertUniqueProjectFiles } from "../../lib/content/project-address";
import { validateProjectStory } from "../../lib/content/project-story";
import type { OptionsComparison } from "../../lib/content/options-comparison";
import { fileOfProject, getPublishedProjects } from "../../lib/projects";
import { getNavigation } from "../../lib/pages";

export async function getStaticPaths() {
  // The file list comes from the file system, not the collection, so two files that
  // make the same slug (x.md and x.mdx) are both seen (the collection keeps only one).
  assertUniqueProjectFiles(
    Object.keys(import.meta.glob("/src/content/projects/**/*.{md,mdx}", { query: "?url" })).map((path) =>
      path.slice("/src/content/projects/".length),
    ),
  );
  // A broken draft must fail the production build too, so every entry is checked
  // before drafts are filtered out. The checked Options table travels to the page as a prop.
  const comparisons = new Map<string, OptionsComparison>();
  for (const entry of await getCollection("projects")) {
    comparisons.set(entry.id, validateProjectStory(fileOfProject(entry), entry.body ?? ""));
  }
  const projects = await getPublishedProjects(process.env);
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry, comparison: comparisons.get(entry.id)! } }));
}

const { entry, comparison } = Astro.props;
const { data } = entry;
// The story components read the project from here (src/env.d.ts) and name its file in errors.
Astro.locals.project = { slug: entry.id, file: fileOfProject(entry), data, comparison };
Astro.locals.pageFile = Astro.locals.project.file;
const { Content } = await render(entry);
const navigation = await getNavigation();

// A project's own sharing image is resized to the Open Graph size; Seo.astro falls
// back to the site default when there is none.
const share = data.image ? await getImage({ src: data.image.src as ImageMetadata, width: 1200, format: "png" }) : undefined;
---

<ProjectLayout
  title={data.title}
  problem={data.problem}
  description={data.description}
  status={data.status}
  themes={data.themes}
  navigation={navigation}
  image={share?.src}
  imageAlt={data.image?.alt}
  draft={data.draft}
  slug={entry.id}
>
  <Content components={{ ProjectPart, OptionsTable }} />
</ProjectLayout>
