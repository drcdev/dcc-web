---
const currentSiteUrl = "https://doncoleman.ca/";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>doncoleman.ca — site being rebuilt</title>
		<style>
			:root {
				color-scheme: light dark;
			}

			body {
				font-family: system-ui, sans-serif;
				max-width: 40rem;
				margin: 4rem auto;
				padding: 0 1.5rem;
				line-height: 1.5;
			}

			a {
				color: #1d4ed8;
			}

			a:focus-visible {
				outline: 3px solid #1d4ed8;
				outline-offset: 2px;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Don Coleman</h1>
			<p>This site is being rebuilt.</p>
			<p>
				<a href={currentSiteUrl}>Visit the current site at doncoleman.ca</a>
			</p>
		</main>
	</body>
</html>
