# Public test values only, for `wrangler dev` under Playwright. Nothing here is a real secret.
# Turnstile's documented always-pass test secret:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CONTACT_READ_TOKEN=e2e-fake-read-token-not-a-secret-0000000000000000
IP_HASH_SALT=e2e-fake-salt-not-a-secret
# Lets the worker accept the testing-key verdict above. Set for preview and e2e only, never production.
ALLOW_TURNSTILE_TESTING=true
