{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dcc-web",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "secrets": { "required": ["TURNSTILE_SECRET_KEY", "CONTACT_READ_TOKEN", "IP_HASH_SALT"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "contact",
      // Placeholder until setup item 19 (Don creates the database); replaced in T074.
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "name": "dcc-web-preview",
      "triggers": { "crons": ["17 3 * * *"] },
      "secrets": { "required": ["TURNSTILE_SECRET_KEY", "CONTACT_READ_TOKEN", "IP_HASH_SALT"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "contact-preview",
          // Placeholder until setup item 19; replaced in T074.
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
