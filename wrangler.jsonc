{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dcc-web",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "triggers": { "crons": [] },
  "secrets": { "required": ["TURNSTILE_SECRET_KEY"] },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "contact@doncoleman.ca",
      "allowed_sender_addresses": ["contact-form@drc.dev"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dcc-web",
      "database_id": "30fa05de-e60c-41c4-8ffc-684d891f6fc9",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "name": "dcc-web-preview",
      "workers_dev": true,
      "preview_urls": true,
      "vars": { "ALLOW_TURNSTILE_TESTING": "true", "SITE_ENVIRONMENT": "preview" },
      "ai": { "binding": "AI" },
      "triggers": { "crons": [] },
      "secrets": { "required": ["TURNSTILE_SECRET_KEY"] },
      "send_email": [
        {
          "name": "CONTACT_EMAIL",
          "destination_address": "contact@doncoleman.ca",
          "allowed_sender_addresses": ["contact-form@drc.dev"]
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dcc-web-preview",
          "database_id": "ab1b7308-0b0b-4b88-87dd-74e88b8dbef1",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
